#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T
                &kp TAB    &kp A  &kp S  &kp D  &kp F  &kp G
                &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B
                &kp LCTRL  &kp LWIN &kp LALT &kp SPACE &mo 1 &kp RET
                &kp C_MUTE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &mo 1s &trans
                &trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Add more layers here as needed
    };
};
